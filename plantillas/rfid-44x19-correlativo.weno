// Plantilla RFID 44 x 19 mm con EPC correlativo en hex.
// EPC (96 bits) = prefijo fijo (16 hex) + correlativo (8 hex).
// El código de barras lleva solo el correlativo para que quepa en 44 mm.
etiqueta 44x19 densidad 300
fuente legible

var prefijo = "3034257BF7194E40"
serie corr desde "00001A85" cantidad 3 hex

rfid "{prefijo}{corr}"

texto "N° {corr}" @ 1.5,1.2 tam 3.4 negrita
texto "Etiqueta {nro} de {total}" @ 1.5,5 tam 2.2
barras "{corr}" @ 1.5,8.2 alto 4.6 modulo 0.17
texto "{prefijo}{corr}" @ 1.5,15.6 tam 1.8 fuente mono

qr "{prefijo}{corr}" @ 31.5,1.5 tam 11
texto "RFID" @ 31.5,13.4 tam 2 ancho 10.6 centro negrita
